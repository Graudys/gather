# ── Copie para .env.local (nunca suba .env.local para o GitHub) ──────────
# O Prisma CLI e o seed também leem este arquivo (prisma.config.ts).

# Supabase › Connect › ORMs › Prisma
# App (pooler de transação, porta 6543)
DATABASE_URL="postgresql://postgres.SEU-REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (pooler de sessão, porta 5432)
DIRECT_URL="postgresql://postgres.SEU-REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Better Auth. Gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Endereço do app (sem barra no fim). Na Vercel: https://seu-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primeiro admin (usado só pelo npm run db:seed). A senha temporária aparece no terminal.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_NAME="Seu nome"

# Arquivos e fotos (Supabase › Project Settings › API Keys)
# URL do projeto e a chave SECRETA (sb_secret_...). Só no servidor: nunca use NEXT_PUBLIC_ aqui.
# O bucket privado "gather-arquivos" é criado sozinho no primeiro envio.
SUPABASE_URL=https://SEU-REF.supabase.co
SUPABASE_SECRET_KEY=

# Recursos de LGPD (exportar dados, excluir conta, cookies). Desligado na versão pessoal.
LGPD_ENABLED=false

# Segredo da rotina diária (/api/cron/diario). Gere com: openssl rand -hex 32
CRON_SECRET=

# Notificações no aparelho (PWA, Web Push). Gere o par com:
#   npx web-push generate-vapid-keys
# A pública pode ir para o navegador; a PRIVADA só no servidor (nunca com NEXT_PUBLIC_).
# Sem as três, o app funciona normal e o botão "Ligar notificações" não aparece.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato para os serviços de push (e-mail ou site seu)
VAPID_SUBJECT=mailto:voce@exemplo.com
# Para testar o PWA no "npm run dev" (no ar ele já vem ligado)
NEXT_PUBLIC_PWA_DEV=1

# LiveKit Cloud › Settings › Keys (reuniões; etapa 4)
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Versão mostrada nos erros (a Vercel preenche VERCEL_GIT_COMMIT_SHA sozinha)
NEXT_PUBLIC_APP_VERSION=dev

# Mostra cada consulta ao banco no terminal (só para achar lentidão em dev).
# PRISMA_LOG=1
