# ── Copie para .env.local (nunca suba .env.local para o GitHub) ──────────

# Supabase › Project Settings › API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: ignora o RLS. Só no servidor. Nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Endereço público do app (sem barra no fim)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LiveKit Cloud › Settings › Keys
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# Resend (e-mails do app; os e-mails de login vão pelo SMTP configurado no Supabase)
RESEND_API_KEY=re_...
EMAIL_FROM="Gather <nao-responda@seu-dominio.com>"
# Para onde vão os alertas de erro crítico
ALERT_EMAIL=voce@seu-dominio.com

# Segredo das rotinas (/api/cron/*). Gere com: openssl rand -hex 32
# O mesmo valor vai no Vault do Supabase com o nome cron_secret.
CRON_SECRET=

# Cloudflare Turnstile (CAPTCHA). Chaves de teste em https://developers.cloudflare.com/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Versão mostrada nos erros (a Vercel preenche VERCEL_GIT_COMMIT_SHA sozinha)
NEXT_PUBLIC_APP_VERSION=dev
