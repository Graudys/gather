// Gather — schema.prisma (versão pessoal: Prisma ORM + Better Auth)
//
// - Só o admin cria contas (Admin › Pessoas) com senha temporária; no primeiro
//   acesso a pessoa troca a senha e confirma 18+ e os termos.
// - Sem cadastro público, sem login com Google, sem e-mail.
// - Recursos de LGPD desligados (PlatformConfig.lgpdEnabled = false).
// - O Supabase é só o Postgres (e o Storage para arquivos).
// - Toda checagem de acesso fica no código: src/_lib/auth/dal.ts e src/_data/*.
//
// Regras que o Prisma não expressa (ficam no código, com teste em tests/):
//   * messages: exatamente um de channel_id / conversation_id.
//   * team/project/channel do mesmo workspace.
//   * workspace_settings: message_retention_months em platform_config.message_retention_options.
//   * admin_actions: só create (nenhuma função de update/delete no código).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// A URL vem do prisma.config.ts (DIRECT_URL para migrations).
datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum WorkspaceKind {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamRole {
  TEAM_ADMIN
  TEAM_MEMBER
}

enum ProjectRole {
  PROJECT_ADMIN
  PROJECT_MEMBER
}

enum ChannelRole {
  CHANNEL_MEMBER
  CHANNEL_MODERATOR
}

enum TeamVisibility {
  WORKSPACE
  PRIVATE
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum ChannelKind {
  TEAM
  PROJECT
  CUSTOM
}

enum ConversationKind {
  DIRECT
  GROUP
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum MeetingEndReason {
  HOST_ENDED
  EMPTY
  MAX_DURATION
  QUOTA_EXHAUSTED
  ADMIN
}

enum MeetingRole {
  HOST
  PARTICIPANT
}

enum EventResponse {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum EventVisibility {
  PRIVATE
  TEAM
  WORKSPACE
}

enum HelpArticleStatus {
  DRAFT
  PUBLISHED
}

enum AccessEvent {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  TEMP_PASSWORD_ISSUED
  ACCESS_DISABLED
}

enum ErrorSource {
  BROWSER
  SERVER
  CRON
  WEBHOOK
}

enum ErrorStatus {
  NEW
  OPEN
  RESOLVED
  IGNORED
  REGRESSED
}

// ───────────────────────── Identidade ─────────────────────────

// ───────────────────────── Identidade (Better Auth) ─────────────────────────
// Só o admin cria contas (Admin › Pessoas). Não existe cadastro público.

model User {
  // generateId: "uuid" no Better Auth = o banco gera o id (gen_random_uuid()).
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String // nome de exibição
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  username           String?   @unique
  bio                String?
  timezone           String?
  // Plugin admin do Better Auth
  role               String    @default("user") // "user" ou "admin"
  banned             Boolean   @default(false) // "Desativar acesso"
  banReason          String?   @map("ban_reason")
  banExpires         DateTime? @map("ban_expires") @db.Timestamptz(6)
  // Primeiro acesso
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at") @db.Timestamptz(6)
  ageConfirmedAt     DateTime? @map("age_confirmed_at") @db.Timestamptz(6) // "Tenho 18 anos ou mais"
  termsAcceptedAt    DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                Session[]
  accounts                Account[]
  workspacesCreated       Workspace[]
  workspaceMemberships    WorkspaceMember[]
  teamsCreated            Team[]
  teamMemberships         TeamMember[]
  projectsCreated         Project[]
  projectMemberships      ProjectMember[]
  channelsCreated         Channel[]
  channelMemberships      ChannelMember[]
  conversationsCreated    Conversation[]
  conversationMemberships ConversationMember[]
  messages                Message[]
  reactions               MessageReaction[]
  attachmentsCreated      MessageAttachment[]
  tasksCreated            Task[]
  taskAssignments         TaskAssignee[]
  taskComments            TaskComment[]
  taskAttachments         TaskAttachment[]
  meetingsCreated         Meeting[]
  meetingParticipations   MeetingParticipant[]
  meetingNotesEdited      MeetingNote[]
  eventsCreated           CalendarEvent[]
  eventParticipations     EventParticipant[]
  activityEvents          ActivityEvent[]
  notifications           Notification[]
  adminActionsDone        AdminAction[]        @relation("AdminActionAdmin")
  adminActionsReceived    AdminAction[]        @relation("AdminActionTarget")
  helpArticlesEdited      HelpArticle[]

  @@map("users")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by") // plugin admin (desligado na interface)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Senha fica aqui (providerId = "credential"), com hash scrypt do Better Auth.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// Limite de tentativas (login, troca de senha, erros do navegador). Janela fixa por chave.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start") @db.Timestamptz(6)

  @@map("rate_limits")
}

// ───────────────────────── Plataforma (admin) ─────────────────────────

// Uma linha só (id = 1). Tudo que aparece em Admin › Configurações.
model PlatformConfig {
  id                       Int      @id @default(1)
  maintenanceMode          Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage       String?  @map("maintenance_message")
  lgpdEnabled              Boolean  @default(false) @map("lgpd_enabled") // "Recursos de LGPD": desligado na versão pessoal
  // Prazos que os workspaces podem escolher
  messageRetentionOptions  Int[]    @default([1, 2, 3, 6, 12]) @map("message_retention_options") // meses
  fileRetentionOptions     Int[]    @default([24, 168]) @map("file_retention_options") // horas
  defaultMessageMonths     Int      @default(3) @map("default_message_months")
  defaultFileHours         Int      @default(24) @map("default_file_hours")
  // Reuniões
  callsForAllWorkspaces    Boolean  @default(true) @map("calls_for_all_workspaces")
  callMinutesPerWorkspace  Int      @default(600) @map("call_minutes_per_workspace")
  callMaxParticipants      Int      @default(5) @map("call_max_participants")
  callMaxDurationMin       Int      @default(60) @map("call_max_duration_min")
  livekitMonthlyMinutes    Int      @default(5000) @map("livekit_monthly_minutes")
  // Contas
  maxOwnedTeamWorkspaces   Int      @default(3) @map("max_owned_team_workspaces")
  tempPasswordHours        Int      @default(168) @map("temp_password_hours") // senha temporária vence depois disso
  // Orbi / central de ajuda
  botEnabled               Boolean  @default(true) @map("bot_enabled")
  botQuestionRetentionDays Int      @default(90) @map("bot_question_retention_days")
  // Registros e erros
  accessLogRetentionDays   Int      @default(180) @map("access_log_retention_days")
  errorRetentionDays       Int      @default(30) @map("error_retention_days")
  errorSpikeThreshold      Int      @default(20) @map("error_spike_threshold")
  errorSpikeWindowMin      Int      @default(10) @map("error_spike_window_min")
  // Anexos
  chatAttachmentMaxMb      Int      @default(10) @map("chat_attachment_max_mb")
  taskAttachmentMaxMb      Int      @default(25) @map("task_attachment_max_mb")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_config")
}

// Registro de ações do admin. Só INSERT (ver nota no topo).
model AdminAction {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId      String?  @map("admin_id") @db.Uuid
  action       String // ex.: calls_enabled, ownership_transferred, member_added, account_blocked, config_changed
  workspaceId  String?  @map("workspace_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  reason       String
  metadata     Json     @default("{}") // antes/depois, sem conteúdo de mensagens
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin      User?       @relation("AdminActionAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User?       @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  workspace  Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_actions")
}

// ───────────────────────── Workspace ─────────────────────────

model Workspace {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String        @unique
  kind                WorkspaceKind @default(TEAM) // PERSONAL é criado no primeiro acesso
  description         String?
  suspendedAt         DateTime?     @map("suspended_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime?     @map("deletion_requested_at") @db.Timestamptz(6) // apaga de vez 30 dias depois
  createdById         String        @map("created_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy       User                 @relation(fields: [createdById], references: [id])
  members         WorkspaceMember[]
  settings        WorkspaceSettings?
  teams           Team[]
  channels        Channel[]
  conversations   Conversation[]
  messages        Message[]
  meetings        Meeting[]
  meetingUsage    WorkspaceMeetingUsage[]
  calendarEvents  CalendarEvent[]
  activityEvents  ActivityEvent[]
  notifications   Notification[]
  adminActions    AdminAction[]

  @@index([kind])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceSettings {
  workspaceId              String            @id @map("workspace_id") @db.Uuid
  allowGuests              Boolean           @default(true) @map("allow_guests")
  defaultChannelVisibility ChannelVisibility @default(PUBLIC) @map("default_channel_visibility")
  // Retenção (janela móvel)
  messageRetentionMonths   Int               @default(3) @map("message_retention_months")
  fileRetentionHours       Int               @default(24) @map("file_retention_hours")
  // Reuniões (ligadas para todos na versão pessoal; o admin pode desligar)
  callsEnabled             Boolean           @default(true) @map("calls_enabled")
  callMinutesQuota         Int?              @map("call_minutes_quota") // nulo = usa platform_config
  callsEnabledAt           DateTime?         @map("calls_enabled_at") @db.Timestamptz(6)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

// ───────────────────────── Equipes ─────────────────────────

model Team {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  name        String
  slug        String
  description String?
  visibility  TeamVisibility @default(WORKSPACE)
  createdById String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])
  members        TeamMember[]
  projects       Project[]
  channels       Channel[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  activityEvents ActivityEvent[]

  @@unique([workspaceId, slug])
  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TeamRole @default(TEAM_MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ───────────────────────── Projetos ─────────────────────────

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String        @map("team_id") @db.Uuid
  name        String
  slug        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  createdById String        @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])
  members        ProjectMember[]
  channels       Channel[]
  taskStatuses   TaskStatus[]
  tasks          Task[]
  taskLabels     TaskLabel[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  activityEvents ActivityEvent[]

  @@unique([teamId, slug])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(PROJECT_MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ───────────────────────── Canais e conversas ─────────────────────────

model Channel {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  teamId      String?           @map("team_id") @db.Uuid
  projectId   String?           @map("project_id") @db.Uuid
  name        String
  description String?
  kind        ChannelKind       @default(CUSTOM)
  visibility  ChannelVisibility @default(PUBLIC)
  createdById String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
  members   ChannelMember[]
  messages  Message[]

  @@index([workspaceId])
  @@index([teamId])
  @@index([projectId])
  @@map("channels")
}

model ChannelMember {
  channelId  String      @map("channel_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  role       ChannelRole @default(CHANNEL_MEMBER)
  lastReadAt DateTime?   @map("last_read_at") @db.Timestamptz(6) // contagem de não lidas

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

model Conversation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  kind        ConversationKind
  createdById String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User              @relation(fields: [createdById], references: [id])
  members   ConversationMember[]
  messages  Message[]

  @@index([workspaceId])
  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

// Sem expires_at: a limpeza apaga created_at < now() - workspace_settings.message_retention_months.
// Quando a mensagem principal expira, as respostas da thread vão junto (cascade).
model Message {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  channelId       String?   @map("channel_id") @db.Uuid
  conversationId  String?   @map("conversation_id") @db.Uuid
  senderId        String?   @map("sender_id") @db.Uuid // nulo = "Pessoa removida"
  parentMessageId String?   @map("parent_message_id") @db.Uuid
  content         String
  editedAt        DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  parent       Message?            @relation("Thread", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies      Message[]           @relation("Thread")
  reactions    MessageReaction[]
  attachments  MessageAttachment[]

  @@index([workspaceId, createdAt]) // usado pela limpeza
  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@index([parentMessageId])
  @@map("messages")
}

model MessageReaction {
  messageId String @map("message_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
}

// Arquivo do chat. Depois de workspace_settings.file_retention_hours, o job apaga o objeto no Storage
// e preenche expired_at; a linha fica para a mensagem mostrar "Arquivo expirado".
model MessageAttachment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  storagePath String?   @map("storage_path") // nulo depois de expirar
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   BigInt    @map("size_bytes")
  expiredAt   DateTime? @map("expired_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([createdAt]) // usado pela limpeza de arquivos
  @@map("message_attachments")
}

// ───────────────────────── Tarefas ─────────────────────────

model TaskStatus {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  name        String
  position    Int
  isCompleted Boolean @default(false) @map("is_completed")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, position])
  @@map("task_statuses")
}

model Task {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  statusId        String       @map("status_id") @db.Uuid
  position        String // índice fracionário (ex.: "a0V"): arrastar muda só este cartão
  title           String
  description     String?
  priority        TaskPriority @default(MEDIUM)
  dueAt           DateTime?    @map("due_at") @db.Timestamptz(6)
  createdById     String?      @map("created_by") @db.Uuid
  sourceMeetingId String?      @map("source_meeting_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        TaskStatus       @relation(fields: [statusId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceMeeting Meeting?         @relation(fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  assignees     TaskAssignee[]
  labelLinks    TaskLabelLink[]
  comments      TaskComment[]
  attachments   TaskAttachment[]

  @@index([projectId, statusId, position])
  @@index([dueAt])
  @@map("tasks")
}

model TaskAssignee {
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  task Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskLabel {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name      String
  color     String

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   TaskLabelLink[]

  @@unique([projectId, name])
  @@map("task_labels")
}

model TaskLabelLink {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_label_links")
}

model TaskComment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// Não expira. "Salvar na tarefa" copia o objeto do chat para cá antes de ele vencer.
model TaskAttachment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId                String   @map("task_id") @db.Uuid
  storagePath           String   @map("storage_path")
  fileName              String   @map("file_name")
  mimeType              String   @map("mime_type")
  sizeBytes             BigInt   @map("size_bytes")
  sourceMessageAttachId String?  @map("source_message_attachment_id") @db.Uuid
  createdById           String?  @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("task_attachments")
}

// ───────────────────────── Reuniões (só áudio) ─────────────────────────

model Meeting {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  teamId          String?           @map("team_id") @db.Uuid
  projectId       String?           @map("project_id") @db.Uuid
  calendarEventId String?           @unique @map("calendar_event_id") @db.Uuid
  createdById     String?           @map("created_by") @db.Uuid
  title           String
  roomKey         String            @unique @map("room_key") // aleatório; nenhuma mídia é guardada
  status          MeetingStatus     @default(SCHEDULED)
  maxParticipants Int               @default(5) @map("max_participants") // copiado de platform_config ao criar
  maxDurationMin  Int               @default(60) @map("max_duration_min")
  startsAt        DateTime?         @map("starts_at") @db.Timestamptz(6)
  startedAt       DateTime?         @map("started_at") @db.Timestamptz(6) // webhook room_started
  hardEndAt       DateTime?         @map("hard_end_at") @db.Timestamptz(6) // started_at + max_duration ou fim do saldo
  endedAt         DateTime?         @map("ended_at") @db.Timestamptz(6)
  endReason       MeetingEndReason? @map("end_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team          Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  calendarEvent CalendarEvent?       @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants  MeetingParticipant[]
  notes         MeetingNote?
  tasks         Task[]

  @@index([workspaceId, startsAt])
  @@index([status, hardEndAt]) // job que encerra salas por tempo ou saldo
  @@map("meetings")
}

// Preenchido pelos webhooks do LiveKit (participant_joined / participant_left).
// Minutos = soma de (left_at - joined_at) por pessoa.
model MeetingParticipant {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String      @map("meeting_id") @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  guestName String?     @map("guest_name")
  role      MeetingRole @default(PARTICIPANT)
  joinedAt  DateTime?   @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime?   @map("left_at") @db.Timestamptz(6)

  meeting Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
  @@map("meeting_participants")
}

// Saldo do mês por workspace. Atualizado a cada participant_left; conferido antes de gerar o token.
model WorkspaceMeetingUsage {
  workspaceId String   @map("workspace_id") @db.Uuid
  month       DateTime @db.Date // primeiro dia do mês
  minutesUsed Int      @default(0) @map("minutes_used")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, month])
  @@map("workspace_meeting_usage")
}

model MeetingNote {
  meetingId   String   @id @map("meeting_id") @db.Uuid
  content     String   @default("")
  decisions   Json     @default("[]")
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("meeting_notes")
}

// ───────────────────────── Calendário ─────────────────────────

model CalendarEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  teamId         String?         @map("team_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  createdById    String?         @map("created_by") @db.Uuid
  title          String
  description    String?
  startsAt       DateTime        @map("starts_at") @db.Timestamptz(6) // sempre UTC
  endsAt         DateTime        @map("ends_at") @db.Timestamptz(6)
  timezone       String
  visibility     EventVisibility @default(TEAM)
  reminderMin    Int?            @default(10) @map("reminder_min") // lembrete no sino
  reminderSentAt DateTime?       @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  meeting      Meeting?
  participants EventParticipant[]

  @@index([workspaceId, startsAt])
  @@index([reminderSentAt, startsAt]) // job de lembretes
  @@map("calendar_events")
}

model EventParticipant {
  eventId  String        @map("event_id") @db.Uuid
  userId   String        @map("user_id") @db.Uuid
  response EventResponse @default(INVITED)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_participants")
}

// ───────────────────────── Atividade e notificações ─────────────────────────

model ActivityEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  teamId      String?  @map("team_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  eventType   String   @map("event_type")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@map("activity_events")
}

// Só no app (sino). A versão pessoal não manda e-mail.
model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid // nulo = aviso da plataforma (suporte, política)
  type        String
  title       String
  body        String?
  payload     Json      @default("{}") // sem conteúdo sensível de mensagens
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ───────────────────────── Suporte e denúncias ─────────────────────────

// ───────────────────────── LGPD ─────────────────────────

// ───────────────────────── Rotina diária (Vercel Cron → /api/cron/diario) ─────────────────────────
// limpeza de mensagens (janela móvel) e de arquivos do chat; lembretes; salas vencidas;
// bot_questions mais velhas que 90 dias; access_logs mais velhos que 180 dias.

// ───────────────────────── Central de ajuda e Orbi ─────────────────────────

model HelpCategory {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String        @unique
  name     String
  icon     String // nome do ícone no app
  position Int
  articles HelpArticle[]

  @@map("help_categories")
}

// Fonte única das respostas do Orbi. Aparece na Central de ajuda (dentro do app) quando PUBLISHED.
model HelpArticle {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String            @map("category_id") @db.Uuid
  slug        String            @unique
  title       String
  summary     String // resposta curta que o Orbi mostra no chat
  body        String // markdown do artigo completo
  keywords    String[]          @default([]) // ajuda a busca: "convite", "chamar pessoa"
  actionLabel String?           @map("action_label") // botão de atalho: "Abrir convites"
  actionPath  String?           @map("action_path") // rota no app: /settings/members?invite=1
  status      HelpArticleStatus @default(DRAFT)
  views       Int               @default(0)
  helpfulYes  Int               @default(0) @map("helpful_yes")
  helpfulNo   Int               @default(0) @map("helpful_no")
  updatedById String?           @map("updated_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  // busca: coluna tsvector em português criada em SQL (to_tsvector('portuguese', title || summary || body))

  category     HelpCategory  @relation(fields: [categoryId], references: [id])
  updatedBy    User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  botQuestions BotQuestion[]

  @@index([categoryId, status])
  @@map("help_articles")
}

// Perguntas feitas ao Orbi, sem identificar quem perguntou. Apagadas depois de bot_question_retention_days.
model BotQuestion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String
  articleId String?  @map("article_id") @db.Uuid // nulo = sem resposta
  helpful   Boolean?
  sentToAdmin Boolean @default(false) @map("sent_to_admin") // "Mandar para o admin"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  article HelpArticle?   @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([articleId])
  @@map("bot_questions")
}

// ─── Registros de acesso (Marco Civil art. 15) ────────────────────────────
// Só entrada, renovação e saída de sessão. Sem FK para users: o registro
// precisa durar os 6 meses mesmo se a conta for excluída. Só platform_admins
// leem (RLS), e cada consulta por pessoa gera uma AdminAction com motivo.
model AccessLog {
  id        BigInt      @id @default(autoincrement())
  userId    String?     @map("user_id") @db.Uuid
  event     AccessEvent
  method    String? // password
  ip        String      @db.Inet
  userAgent String?     @map("user_agent") // resumido: navegador + sistema
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("access_logs")
}

// ─── Erros do app, agrupados ──────────────────────────────────────────────
// Um registro por grupo (fingerprint = tipo + mensagem normalizada + local).
// Nunca guardar texto de mensagem, e-mail, token ou conteúdo: só IDs.
model ErrorEvent {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint        String      @unique
  source             ErrorSource
  status             ErrorStatus @default(NEW)
  message            String // até 500 caracteres
  location           String // rota, função ou rotina
  stack              String? // até 8 KB
  release            String? // versão do deploy
  count              Int         @default(1)
  usersAffected      Int         @default(0) @map("users_affected")
  sampleUserIds      String[]    @default([]) @map("sample_user_ids") @db.Uuid // até 20
  sampleWorkspaceIds String[]    @default([]) @map("sample_workspace_ids") @db.Uuid
  browsers           Json? // {"Chrome": 18, "Safari": 3}
  firstSeenAt        DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt         DateTime?   @map("resolved_at") @db.Timestamptz(6)
  resolvedById       String?     @map("resolved_by_id") @db.Uuid
  alertedAt          DateTime?   @map("alerted_at") @db.Timestamptz(6)

  hourly ErrorHourlyCount[]

  @@index([status, lastSeenAt])
  @@map("error_events")
}

// Contagem por hora de cada grupo (gráfico e detecção de pico). Some com o grupo.
model ErrorHourlyCount {
  errorId String     @map("error_id") @db.Uuid
  hour    DateTime   @db.Timestamptz(6)
  count   Int        @default(0)
  error   ErrorEvent @relation(fields: [errorId], references: [id], onDelete: Cascade)

  @@id([errorId, hour])
  @@map("error_hourly_counts")
}
