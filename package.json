    "geist": "^1.9.2",
    "livekit-client": "^2.25.0",
    "livekit-server-sdk": "^2.20.1",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
